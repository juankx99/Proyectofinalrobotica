Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Reference Frame: <Fixed Frame>
    Cell Size: 1
    Plane Cell Count: 20
    Color: 160; 160; 164
  - Class: rviz_default_plugins/Map
    Name: Map
    Enabled: true
    Alpha: 0.8
    Color Scheme: map
    Draw Behind: true
    Topic:
      Value: /map
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Depth: 5
    Update Topic:
      Value: /map_updates
      Durability Policy: Volatile
      Reliability Policy: Reliable
      Depth: 5
  - Class: rviz_default_plugins/Map
    Name: Costmap global
    Enabled: true
    Alpha: 0.3
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Value: /global_costmap/costmap
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Depth: 5
    Update Topic:
      Value: /global_costmap/costmap_updates
      Durability Policy: Volatile
      Reliability Policy: Reliable
      Depth: 5
  - Class: rviz_default_plugins/Map
    Name: Costmap local
    Enabled: true
    Alpha: 0.5
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Value: /local_costmap/costmap
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Depth: 5
    Update Topic:
      Value: /local_costmap/costmap_updates
      Durability Policy: Volatile
      Reliability Policy: Reliable
      Depth: 5
  - Class: rviz_default_plugins/RobotModel
    Name: RobotModel
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Depth: 5
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Show Names: false
    Show Axes: true
    Show Arrows: false
    Marker Scale: 0.5
  - Class: rviz_default_plugins/LaserScan
    Name: LaserScan
    Enabled: true
    Topic:
      Value: /scan
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 5
    Style: Points
    Size (Pixels): 4
    Color Transformer: FlatColor
    Color: 255; 0; 0
  - Class: rviz_default_plugins/Odometry
    Name: Odometry
    Enabled: false
    Topic:
      Value: /odom
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
    Keep: 50
    Shape:
      Value: Arrow
      Shaft Length: 0.3
      Shaft Radius: 0.02
      Head Length: 0.08
      Head Radius: 0.05
    Covariance:
      Value: false
  - Class: nav2_rviz_plugins/ParticleCloud
    Name: Particulas AMCL
    Enabled: true
    Alpha: 1
    Color: 0; 180; 0
    Shape: Arrow (Flat)
    Min Arrow Length: 0.02
    Max Arrow Length: 0.3
    Topic:
      Value: /particle_cloud
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Filter size: 10
  - Class: rviz_default_plugins/PoseWithCovariance
    Name: Pose AMCL
    Enabled: true
    Topic:
      Value: /amcl_pose
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
    Shape: Arrow
    Color: 255; 25; 0
    Shaft Length: 0.5
    Shaft Radius: 0.04
    Head Length: 0.15
    Head Radius: 0.1
    Covariance:
      Value: true
      Position:
        Value: true
        Color: 204; 51; 204
        Alpha: 0.3
        Scale: 1
      Orientation:
        Value: true
        Color: 255; 255; 127
        Alpha: 0.5
        Scale: 1
        Frame: Local
  - Class: rviz_default_plugins/Path
    Name: Plan global
    Enabled: true
    Color: 0; 200; 0
    Line Style: Billboards
    Line Width: 0.04
    Topic:
      Value: /plan
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Polygon
    Name: Huella
    Enabled: true
    Color: 25; 255; 0
    Topic:
      Value: /local_costmap/published_footprint
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/PointStamped
    Name: Lookahead
    Enabled: true
    Color: 255; 120; 0
    Radius: 0.08
    Topic:
      Value: /lookahead_point
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/MarkerArray
    Name: Waypoints mision
    Enabled: true
    Topic:
      Value: /mission_waypoints
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
    Namespaces:
      labels: true
      waypoints: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Value: /goal_pose
  - Class: rviz_default_plugins/PublishPoint
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 50
      X: 0
      Y: 0
Window Geometry:
  Width: 1200
  Height: 800
